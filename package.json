{
  "name": "rig-plugin",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test scripts/*.spec.ts && npm run typecheck:mod && claude plugin test .",
    "typecheck": "tsc -p scripts/tsconfig.json",
    "typecheck:mod": "tsc -p tsconfig.json",
    "validate": "claude plugin validate .claude-plugin/plugin.json",
    "test:integration:self": "node tests/integration/selftest.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
