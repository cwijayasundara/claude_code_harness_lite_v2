{
  "fast": { "typecheck": "npm run typecheck" },
  "full": { "typecheck": "npm run typecheck", "test": "node --disable-warning=ExperimentalWarning --test scripts/*.spec.ts" },
  "tests": ["**/test/**", "**/tests/**", "**/__tests__/**", "**/*.test.*", "**/*.spec.*", "**/*_test.*", "**/test_*.py", "**/*Test.java", "**/*_spec.rb", "scripts/*.spec.ts"],
  "fixtures": ["scripts/check.spec.ts", "scripts/gate.spec.ts", "scripts/sensors.spec.ts", "scripts/seeded.spec.ts"],
  "ignore": ["**/*.md", "**/*.lock", "**/package-lock.json", "tests/trials/**"],
  "limits": { "fileLines": 500, "diffLines": 1500 }
}
