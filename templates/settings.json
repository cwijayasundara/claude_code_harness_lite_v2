{
  "$comment": "Project settings for the sdlc harness. Merge into <project>/.claude/settings.json and commit. superpowers is off so sdlc routes all work (turn it on only for \"build\": \"sdd\"); turn off any other plugin your team does not use here too. Evidence is protected by these rules and by CI, which recomputes every verdict: a shell script can still write a file, so CI plus branch protection is the boundary.",
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false
  },
  "model": "claude-sonnet-5-5",
  "autoCompactWindow": 200000,
  "permissions": {
    "allow": [
      "Edit(.sdlc/**)",
      "Bash(node --disable-warning=ExperimentalWarning .sdlc/bin/sdlc.ts *)"
    ],
    "ask": [
      "Edit(/.sdlc/sensors.json)",
      "Edit(/.sdlc/rules.json)",
      "Edit(/.sdlc/evals/*.json)",
      "Edit(/.claude/settings.json)",
      "Edit(/.sdlc/bin/**)",
      "Edit(/.sdlc/githooks/**)",
      "Edit(/.sdlc/mod/**)",
      "Edit(/.sdlc/guides/**)",
      "Edit(/.github/workflows/rig-check.yml)",
      "Edit(/CODEOWNERS)",
      "Edit(/.github/CODEOWNERS)",
      "Edit(/migrations/**)",
      "Edit(/infra/**)",
      "Bash(node --disable-warning=ExperimentalWarning .sdlc/bin/sdlc.ts evals*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(/.sdlc/approvals.jsonl)",
      "Edit(/.sdlc/waivers.jsonl)",
      "Edit(/.sdlc/usage.jsonl)",
      "Edit(/.sdlc/spend-cache.json)",
      "Edit(/.sdlc/spend-fetched)",
      "Edit(/.sdlc/budget-seen.json)",
      "Edit(/.sdlc/.gate)",
      "Edit(/.sdlc/.baseline)",
      "Edit(/.sdlc/unresolved.json)",
      "Edit(/.sdlc/PREFLIGHT.md)",
      "Edit(/.sdlc/evals/results.jsonl)",
      "Edit(/.sdlc/gates.jsonl)",
      "Edit(/.sdlc/watch/*.jsonl)",
      "Edit(/.sdlc/changes/*/runs.jsonl)",
      "Edit(/.sdlc/changes/*/verification.md)",
      "Edit(/.sdlc/changes/*/impact.json)",
      "Edit(/.sdlc/changes/*/ratchet.json)",
      "Edit(/.sdlc/changes/*/events.jsonl)",
      "Edit(/.sdlc/changes/*/pr.md)",
      "Edit(/.sdlc/changes/*/ship.json)"
    ]
  },
  "env": {
    "CLAUDE_CODE_DISABLE_ADVISOR_TOOL": "true",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-haiku-5-5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-5-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5-5",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5"
  }
}
