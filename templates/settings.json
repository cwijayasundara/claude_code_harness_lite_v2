{
  "$comment": "Project settings for the sdlc harness. Merge into <project>/.claude/settings.json and commit. superpowers is off so sdlc routes all work (turn it on only for \"build\": \"sdd\"); turn off any other plugin your team does not use here too. Evidence is protected by these rules and by CI, which recomputes every verdict: a shell script can still write a file, so CI plus branch protection is the boundary. ENABLE_STOP_REVIEW=0 turns off the security-guidance plugin's review on every Stop and SubagentStop (an agentic Opus review of the whole diff, twice, per turn): rig's reviewer or /security-review at the PR node is the one review per change; its commit and push reviews stay.",
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false
  },
  "model": "claude-sonnet-5-5",
  "autoCompactWindow": 200000,
  "permissions": {
    "allow": [
      "Edit(.rig/**)",
      "Bash(node --disable-warning=ExperimentalWarning .rig/bin/sdlc.ts *)"
    ],
    "ask": [
      "Edit(/.rig/sensors.json)",
      "Edit(/.rig/rules.json)",
      "Edit(/.rig/evals/*.json)",
      "Edit(/.claude/settings.json)",
      "Edit(/.rig/bin/**)",
      "Edit(/.rig/githooks/**)",
      "Edit(/.rig/mod/**)",
      "Edit(/.rig/guides/**)",
      "Edit(/.github/workflows/rig-check.yml)",
      "Edit(/CODEOWNERS)",
      "Edit(/.github/CODEOWNERS)",
      "Edit(/migrations/**)",
      "Edit(/infra/**)",
      "Bash(node --disable-warning=ExperimentalWarning .rig/bin/sdlc.ts evals*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(/.rig/approvals.jsonl)",
      "Edit(/.rig/waivers.jsonl)",
      "Edit(/.rig/usage.jsonl)",
      "Edit(/.rig/spend-cache.json)",
      "Edit(/.rig/spend-fetched)",
      "Edit(/.rig/budget-seen.json)",
      "Edit(/.rig/.gate)",
      "Edit(/.rig/.baseline)",
      "Edit(/.rig/unresolved.json)",
      "Edit(/.rig/PREFLIGHT.md)",
      "Edit(/.rig/evals/results.jsonl)",
      "Edit(/.rig/gates.jsonl)",
      "Edit(/.rig/watch/*.jsonl)",
      "Edit(/.rig/changes/*/runs.jsonl)",
      "Edit(/.rig/changes/*/verification.md)",
      "Edit(/.rig/changes/*/impact.json)",
      "Edit(/.rig/changes/*/ratchet.json)",
      "Edit(/.rig/changes/*/events.jsonl)",
      "Edit(/.rig/changes/*/pr.md)",
      "Edit(/.rig/changes/*/ship.json)"
    ]
  },
  "env": {
    "ENABLE_STOP_REVIEW": "0",
    "CLAUDE_CODE_DISABLE_ADVISOR_TOOL": "true",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-haiku-5-5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-5-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5-5",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5"
  }
}
